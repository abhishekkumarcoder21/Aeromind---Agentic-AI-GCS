# ──────────────────────────────────────────────
# AeroMind — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.

# ── Database ──
DATABASE_URL=postgresql+asyncpg://aeromind:aeromind@postgres:5432/aeromind
DATABASE_URL_SYNC=postgresql://aeromind:aeromind@postgres:5432/aeromind

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── LLM Provider ──
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1

# ── Simulator ──
TELEMETRY_INTERVAL_MS=1000
HEARTBEAT_INTERVAL_MS=2000
HEARTBEAT_TIMEOUT_SECONDS=10
INITIAL_UAV_COUNT=8

# ── Safety ──
MIN_BATTERY_PERCENT=25
MIN_SEPARATION_METERS=50
MIN_GPS_SATELLITES=6
MIN_SIGNAL_STRENGTH=-80
GEOFENCE_ENABLED=true

# ── Backend ──
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
